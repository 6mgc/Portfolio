---
import Base from '../../layouts/Base.astro';
import Metric from '../../components/Metric.astro';
import Placeholder from '../../components/Placeholder.astro';
import ProjectCards from '../../components/ProjectCards.astro';

/*
 * Copy is transcribed from a low-resolution screenshot of the Framer case study: proofread before launch.
 * Content marked [bracketed] in a Placeholder or a .todo paragraph still needs Megan's real material.
 * Nothing here should be filled in with invented research findings, team details, or numbers.
 */

const meta = [
  { label: 'Role', value: 'Product Designer (Lead UI)' },
  { label: 'Focus', value: 'Conversion Rate Optimization, 1:1 Personalization, and Loyalty Integration' },
  { label: 'Mission', value: 'To make large-scale retail feel personal by delivering 1:1 value at every touchpoint' },
];

const challenges = [
  {
    title: 'Revenue leakage',
    body: 'This friction accounted for "lost sales" that could have been easily converted if the right promo was surfaced at the right moment.',
  },
  {
    title: 'The personalization gap',
    body: 'There were no active elements on the Weekly Deals page to notify users when a wishlisted or previously viewed item went on sale.',
  },
  {
    title: 'Loyalty blind spot',
    body: 'Triangle Rewards offers were obscure and disconnected from the shopping flow, leading to checkout confusion and abandoned carts.',
  },
];

const components = [
  {
    name: '"Price Drop" reminders',
    what: 'I created a carousel that targets logged-in users with items they previously interacted with (Add to Cart, Wishlist, or PDP view) that have now gone on sale.',
    why: 'This recovers "lost sales" by surfacing relevant discounts at the exact moment of user intent.',
  },
  {
    name: 'Frictionless loyalty via 1:1 Triangle Offers',
    what: 'I integrated obscure 1:1 loyalty offers into a compact design directly on the Weekly Deals page.',
    why: 'This reduced decision-making friction, allowing users to shop their personalized offers in a single view, which improved NPS and Loyalty Activation.',
  },
  {
    name: 'Driving urgency with the "30% Club"',
    what: 'I designed a personalized "Biggest Savings" component featuring products at 30% off or more.',
    why: '"Limited time" messaging created a sense of urgency, and drove more clicks and engagement.',
  },
  {
    name: 'Personalized category quick-selection',
    what: 'A selection tool that provides one-tap access to "Trending Categories" tailored to the user\'s profile.',
    why: 'This quick-selection component guides users directly to high-intent sections, letting them bypass the traditional navigation menu.',
  },
];

// Participant quotes from usability testing. Transcribed from a blurry screenshot: check each against the source.
const quotes = [
  {
    theme: 'Personalization',
    quote: 'I think I prefer the [proposed page]. I just felt like it had more to offer. There were more features… like it was tailored and made for me.',
  },
  {
    theme: 'Convenience',
    quote: "It's good to be able to quickly click into my particular categories and not have to go into the category section here.",
  },
  {
    theme: 'Utility',
    quote: "Cause you typically have a list of things you're sort of looking at, um, and it's kind of cool to see when they pop on sale.",
  },
  {
    theme: 'Urgency',
    quote: "I really want to know about the products where I can save some money. And this section clearly stands out and it's clear that its intention is to help me identify those products that are discounted for limited time.",
  },
];
---

<Base
  title="Canadian Tire: Personalized Deals"
  description="Case study: rule-based smart components that shipped personalization impact at Canadian Tire."
>
  <!-- 1. Header -->
  <section class="head">
    <div class="container">
      <a class="back" href="/#work">← All work</a>
      <p class="eyebrow">Case study · Canadian Tire</p>
      <h1>Boosting retail engagement through <strong>personalized <span class="accent">deals</span></strong></h1>
      <dl class="meta">
        {
          meta.map((m) => (
            <div>
              <dt class="eyebrow">{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
      </dl>
      <Placeholder label="Hero product screenshot" ratio="16 / 8" />
      <a class="cta visit" href="https://www.canadiantire.ca/en/promotions/weekly-deals.html" target="_blank" rel="noopener">
        Visit the site <span class="cta__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- 2. Challenges -->
  <section class="section">
    <div class="container split">
      <p class="eyebrow">01 · The challenges</p>
      <div>
        <p class="lead">
          The retail market is shifting toward AI-driven personalization, and Canadian Tire has a vision to fully
          automate the user journey. However, the current reality involves technical constraints that make a full AI
          rollout a long-term goal.
        </p>
        <p class="sub">
          Instead of waiting for perfect infrastructure, my mission was to maximize design impact within existing
          resources.
        </p>
        <div class="cols">
          {
            challenges.map((c) => (
              <div class="col">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Results -->
  <section class="section">
    <div class="container split">
      <p class="eyebrow">02 · The results</p>
      <div class="stack">
        <div class="results">
          <Metric id="conversionLift" size="lg" />
          <Metric id="omniChannelLift" size="lg" />
          <Metric id="pdpViewRate" size="lg" />
          <Metric id="attributedRevenue" size="lg" />
        </div>
        <p class="sub">
          Successfully reduced the "Discovery Gap" by delivering a personalized and relevant shopping experience for
          Canadians, increasing 1:1 weekly offer awareness and Triangle Rewards sign-ups.
        </p>
        <p class="todo">[Number of activated sessions the page drove: unreadable in the screenshot (9k+?).]</p>
      </div>
    </div>
  </section>

  <!-- 4. Research & discovery -->
  <section class="section">
    <div class="container split">
      <p class="eyebrow">03 · Research &amp; discovery</p>
      <div class="stack">
        <p class="todo">[How the problems were found: analytics, session recordings, support tickets.]</p>
        <h3>Options considered</h3>
        <p class="todo">[Alternatives considered and why each was rejected. This is the section hiring managers look for.]</p>
        <Placeholder label="Discovery artefact: funnel, journey map, or session clip" ratio="16 / 7" />
      </div>
    </div>
  </section>

  <!-- 5. Team & role -->
  <section class="section">
    <div class="container split">
      <p class="eyebrow">04 · Team &amp; role</p>
      <div class="stack">
        <p class="todo">[Squad size and makeup (PM, engineers, data, marketing).]</p>
        <p class="todo">[What you owned end-to-end vs. what you contributed to.]</p>
      </div>
    </div>
  </section>

  <!-- 6. Strategy: smart components -->
  <section class="section">
    <div class="container split">
      <p class="eyebrow">05 · The strategy</p>
      <div class="stack">
        <p class="lead">Architecting a <strong>1:1 personalized</strong> shopping journey.</p>
        <p class="sub">
          I designed a suite of "Smart Components" based on business epics, specifically engineered to create a
          tailored, intuitive experience for every authenticated user.
        </p>
        {
          components.map((c, i) => (
            <article class="component">
              <div class="component__text">
                <span class="eyebrow">0{i + 1}</span>
                <h3>{c.name}</h3>
                <p>{c.what}</p>
                <p class="sub">{c.why}</p>
              </div>
              <Placeholder label={`${c.name}: annotated before/after`} ratio="4 / 3" />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 7. Usability testing -->
  <section class="section">
    <div class="container split">
      <!-- Brief: move before the strategy section if testing shaped the final designs; otherwise keep as validation. -->
      <p class="eyebrow">06 · Validation</p>
      <div class="stack">
        <p class="lead">
          Usability testing confirmed that personalization <strong>reduced friction</strong> and increased perceived
          value.
        </p>
        <h3>What did the users think?</h3>
        <div class="quotes">
          {
            quotes.map((q) => (
              <figure class="quote">
                <figcaption class="eyebrow">{q.theme}</figcaption>
                <blockquote>"{q.quote}"</blockquote>
              </figure>
            ))
          }
        </div>
        <p class="todo">[Method and participants: how many people, what they were asked to do.]</p>
      </div>
    </div>
  </section>

  <!-- 8. Summary + next steps -->
  <section class="section">
    <div class="container split">
      <p class="eyebrow">07 · Summary</p>
      <div class="stack">
        <!-- The revenue and conversion figures here repeat src/data/metrics.ts: update both together. -->
        <p>
          This personalized approach drove $540K in attributed revenue impact within a single quarter. The strategy achieved an exceptional 26.61% online conversion rate
          by <strong>surfacing the right deal to the right user at the right time.</strong>
        </p>
        <h3>Next steps: scaling for vision</h3>
        <p>
          With Phase 1 driving strong performance, the next priority is to leverage the data gathered to transition
          from rule-based logic to <strong>full AI automation</strong>, scaling the carousels across different banners.
        </p>
      </div>
    </div>
  </section>

  <!-- 9. More work -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">More work</p>
      <ProjectCards exclude="canadian-tire" layout={3} />
    </div>
  </section>
</Base>

<style>
  .head {
    padding: clamp(48px, 8vw, 96px) 0 clamp(64px, 8vw, 96px);
  }
  .back {
    display: inline-block;
    font-size: 14px;
    text-decoration: none;
    color: var(--ink-muted);
    margin-bottom: 40px;
  }
  .back:hover {
    color: var(--ink);
  }
  h1 {
    font-size: clamp(40px, 7vw, 88px);
    letter-spacing: -0.03em;
    max-width: 16ch;
    margin: 20px 0 48px;
  }
  .meta {
    display: grid;
    grid-template-columns: 1fr 2fr 2fr;
    gap: 24px;
    margin: 0 0 48px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  dd {
    margin: 8px 0 0;
  }
  .visit {
    margin-top: 24px;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 32px;
  }
  .lead {
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    max-width: 32ch;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h3 {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .sub {
    color: var(--ink-muted);
    max-width: 62ch;
  }
  .quotes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .quote {
    margin: 0;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .quote blockquote {
    margin: 0;
    font-style: italic;
    color: var(--ink-muted);
  }
  .todo {
    color: var(--ink-muted);
    background: var(--placeholder);
    border: 1px dashed var(--dash);
    border-radius: var(--radius);
    padding: 12px 16px;
    font-size: 15px;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }
  .col {
    border-top: 1px solid var(--line-strong);
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .results {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 48px 32px;
  }

  .component {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 32px;
    align-items: start;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .component__text {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (max-width: 800px) {
    .meta,
    .split,
    .cols,
    .results,
    .component,
    .quotes {
      grid-template-columns: 1fr;
    }
  }
</style>
