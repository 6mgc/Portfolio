---
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import ProjectCards from '../../components/ProjectCards.astro';
import { projects, type Project } from '../../data/site';
import { caseStudies, type Section } from '../../data/case-studies';

/*
 * Case study pages for the secondary projects. Canadian Tire has its own page (canadian-tire.astro).
 * Content lives in src/data/case-studies.ts. Anything missing renders as a dashed .todo box.
 */
export function getStaticPaths() {
  return projects
    .filter((p) => p.slug !== 'canadian-tire')
    .map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const cs = caseStudies[project.slug];
const empty = (todo: string): Section => ({ todo: [todo] });

const sections: { title: string; body: Section; shot?: string; metrics?: boolean }[] = [
  { title: 'The problem', body: cs?.problem ?? empty("[Who the users were, what wasn't working, and why it mattered.]") },
  { title: 'Outcome', body: cs ? (cs.outcome ?? {}) : empty('[Results. Only numbers you can source.]'), metrics: true },
  {
    title: 'Research & discovery',
    body: cs?.research ?? empty('[How you found the problem: interviews, analytics, competitive review.]'),
    shot: `${project.name}: research artefact`,
  },
  { title: 'Team & role', body: cs?.team ?? empty('[Team size, and what you owned vs. contributed to.]') },
  {
    title: 'The design',
    body: cs?.design ?? empty('[Key design decisions, the reasoning behind each, and options rejected.]'),
    shot: `${project.name}: final designs`,
  },
  { title: 'Validation', body: cs?.validation ?? empty('[Testing method, what you learned, what changed.]') },
  { title: 'Reflection', body: cs?.reflection ?? empty('[What you learned and what you would do next.]') },
];
---

<Base title={project.name} description={`Case study: ${project.name}, ${project.role}.`}>
  <section class="head">
    <div class="container">
      <a class="back" href="/#work">← All work</a>
      <p class="eyebrow">Case study · {project.name}</p>
      <h1>{project.name}</h1>
      {cs?.headline ? <p class="headline">{cs.headline}</p> : <p class="todo">[One-line headline: what you did and the impact.]</p>}
      {cs?.subhead && <p class="subhead">{cs.subhead}</p>}
      <dl class="meta">
        <div>
          <dt class="eyebrow">Role</dt>
          <dd>{project.role}</dd>
        </div>
        {
          cs ? (
            cs.meta.map((m) => (
              <div>
                <dt class="eyebrow">{m.label}</dt>
                <dd>{m.value}</dd>
              </div>
            ))
          ) : (
            <div>
              <dt class="eyebrow">Details</dt>
              <dd class="todo">[Responsibilities, team size, duration]</dd>
            </div>
          )
        }
      </dl>
      <Placeholder label={`${project.name}: hero screenshot`} ratio="16 / 8" />
    </div>
  </section>

  {
    sections.map((s, i) => (
      <section class="section">
        <div class="container split">
          <p class="eyebrow">
            0{i + 1} · {s.title}
          </p>
          <div class="stack">
            {s.metrics && cs?.metrics && (
              <div class="metrics">
                {cs.metrics.map((m) => (
                  <div class="metric">
                    <span class="metric__value">{m.value}</span>
                    <span class="metric__label">{m.label}</span>
                  </div>
                ))}
              </div>
            )}
            {s.body.items?.map((it) => (
              <p class="item">
                {it.lead && <strong>{it.lead}.</strong>} {it.text}
              </p>
            ))}
            {s.body.todo?.map((t) => (
              <p class="todo">{t}</p>
            ))}
            {s.shot && <Placeholder label={s.shot} ratio="16 / 7" />}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section">
    <div class="container">
      <p class="eyebrow">More work</p>
      <ProjectCards exclude={project.slug} />
    </div>
  </section>
</Base>

<style>
  .head {
    padding: clamp(48px, 8vw, 96px) 0 clamp(64px, 8vw, 96px);
  }
  .back {
    display: inline-block;
    font-size: 14px;
    text-decoration: none;
    color: var(--ink-muted);
    margin-bottom: 40px;
  }
  .back:hover {
    color: var(--ink);
  }
  h1 {
    font-size: clamp(40px, 7vw, 88px);
    letter-spacing: -0.03em;
    margin: 20px 0 24px;
  }
  .headline {
    font-size: clamp(20px, 2.2vw, 26px);
    line-height: 1.35;
    max-width: 40ch;
  }
  .subhead {
    color: var(--ink-muted);
    margin-top: 8px;
  }
  .meta {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr 1fr;
    gap: 24px;
    margin: 40px 0 48px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  dd {
    margin: 8px 0 0;
  }
  .split {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 32px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .item {
    max-width: 62ch;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line);
  }
  .metric {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .metric__value {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent);
  }
  .metric__label {
    font-size: 14px;
    color: var(--ink-muted);
  }
  .todo {
    color: var(--ink-muted);
    background: var(--placeholder);
    border: 1px dashed #c8c8c8;
    border-radius: var(--radius);
    padding: 12px 16px;
    font-size: 15px;
  }
  @media (max-width: 800px) {
    .meta,
    .split,
    .metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
