---
import Base from '../layouts/Base.astro';
import StatusPill from '../components/StatusPill.astro';
import { site } from '../data/site';

interface Sticker {
  src: string;
  alt: string;
  width: number;
  height: number;
  tilt: number;
}

interface EmojiSticker {
  char: string;
  label: string;
  tilt: number;
}

const interests: { name: string; text: string; href?: string; sticker?: Sticker; emoji?: EmojiSticker[] }[] = [
  {
    name: 'Photography',
    text: 'Chasing light and moments around Toronto, finding stories in everyday corners.',
    sticker: { src: '/images/sticker-camera.webp', alt: 'A black compact camera', width: 480, height: 322, tilt: -7 },
  },
  {
    name: 'Music',
    text: "Good beats = good design flow. There's always something playing while I work.",
    sticker: { src: '/images/sticker-music.webp', alt: 'A music app icon', width: 240, height: 240, tilt: 6 },
  },
  {
    name: 'Travelling',
    text: 'Every new city teaches me something about how people navigate spaces and experiences.',
    emoji: [{ char: '✈️', label: 'Airplane', tilt: -10 }],
  },
  {
    name: 'Nature escapes',
    text: "Hiking Toronto's trails or getting lost in parks. My best ideas come when I step away from the screen.",
    emoji: [
      { char: '🌳', label: 'Tree', tilt: -6 },
      { char: '🏖️', label: 'Beach', tilt: 8 },
    ],
  },
  {
    name: 'Hand-building pottery',
    text: 'Getting my hands dirty with clay reminds me that the best designs come from trial, error, and embracing the messy process.',
    sticker: {
      src: '/images/sticker-pottery.webp',
      alt: 'Hand-built cups, bowls and a green checkered dish',
      width: 400,
      height: 400,
      tilt: -4,
    },
  },
  { name: 'AI experiments', text: 'Calling myself a vibe-coder, thanks to AI!', href: '/playground' },
];
---

<Base title="About" description="Megan Cheng: Hong Kong-born, Toronto-based product designer.">
  <section class="about">
    <div class="container grid">
      <div class="text">
        <StatusPill />
        <h1>Hi, I'm <strong>Megan<span class="accent">.</span></strong></h1>
        <p class="lead">
          Hong Kong-born, Toronto-based. At Canadian Tire, I learned that good design
          has to move the <strong>P&amp;L</strong>, not just a usability score.
        </p>
        <p class="bio">
          As a Product Designer, I leverage my background in advertising to create user-centric e-commerce
          experiences. My East-meets-West perspective and passion for visual storytelling help me create digital
          experiences that truly connect with users.
        </p>
        <p>Open to product design roles in retail, banking, and AI product.</p>
        <div class="links">
          <a class="cta cta--primary" href={`mailto:${site.email}`}>Get in touch <span class="cta__arrow" aria-hidden="true">→</span></a>
          <a class="cta" href={site.linkedin} target="_blank" rel="noopener">LinkedIn <span class="cta__arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <img class="headshot" src="/images/megan-cheng.webp" alt="Megan Cheng smiling outdoors in a leafy Toronto park" width="760" height="950" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">What fuels my creativity</p>
      <h2>I design with curiosity, creativity, and <strong>a lot of <span class="accent">coffee</span></strong>.</h2>
      <ul class="interests">
        {
          interests.map((it) => (
            <li class:list={{ 'has-sticker': it.sticker || it.emoji }}>
              {it.emoji && (
                <span class="emoji-stickers">
                  {it.emoji.map((e) => (
                    <span class="emoji-sticker" role="img" aria-label={e.label} style={`--tilt: ${e.tilt}deg`}>
                      {e.char}
                    </span>
                  ))}
                </span>
              )}
              {it.sticker && (
                <img
                  class="sticker"
                  src={it.sticker.src}
                  alt={it.sticker.alt}
                  width={it.sticker.width}
                  height={it.sticker.height}
                  loading="lazy"
                  decoding="async"
                  style={`--tilt: ${it.sticker.tilt}deg; --w: ${it.sticker.width > it.sticker.height ? 100 : 76}px`}
                />
              )}
              <h3>{it.name}</h3>
              <p>{it.text}</p>
              {it.href && (
                <a class="cta" href={it.href}>
                  See the playground <span class="cta__arrow" aria-hidden="true">→</span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .about {
    padding: clamp(64px, 10vw, 128px) 0;
  }
  .grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 48px;
    align-items: center;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }
  h1 {
    font-size: clamp(48px, 8vw, 96px);
    letter-spacing: -0.03em;
  }
  .lead {
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.3;
    max-width: 30ch;
  }
  .headshot {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  .bio {
    max-width: 60ch;
  }
  h2 {
    font-size: clamp(28px, 4vw, 48px);
    max-width: 22ch;
    margin: 16px 0 48px;
  }
  .interests {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 64px 32px;
  }
  .interests li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    border-top: 1px solid var(--line-strong);
    padding-top: 20px;
  }
  .interests li {
    position: relative;
  }
  /* Stickers: white die-cut border, a slight tilt, and a soft lift on hover. */
  .sticker {
    position: absolute;
    top: -50px;
    right: 0;
    width: var(--w, 80px);
    height: auto;
    padding: 5px;
    background: #ffffff;
    border-radius: 12px;
    box-shadow:
      0 1px 2px rgb(17 17 17 / 0.12),
      0 6px 16px rgb(17 17 17 / 0.14);
    transform: rotate(var(--tilt, 0deg));
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.35s ease;
  }
  .has-sticker:hover .sticker {
    transform: rotate(0deg) translateY(-4px) scale(1.06);
    box-shadow:
      0 2px 4px rgb(17 17 17 / 0.12),
      0 12px 24px rgb(17 17 17 / 0.18);
  }
  /* Emoji stickers: a white die-cut outline built from stacked drop-shadows. */
  .emoji-stickers {
    position: absolute;
    top: -42px;
    right: 0;
    display: flex;
    gap: 4px;
  }
  .emoji-sticker {
    display: inline-block;
    font-size: 48px;
    line-height: 1;
    filter: drop-shadow(2px 0 0 #fff) drop-shadow(-2px 0 0 #fff) drop-shadow(0 2px 0 #fff) drop-shadow(0 -2px 0 #fff)
      drop-shadow(0 4px 6px rgb(17 17 17 / 0.2));
    transform: rotate(var(--tilt, 0deg));
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .has-sticker:hover .emoji-sticker {
    transform: rotate(0deg) translateY(-4px) scale(1.08);
  }
  .has-sticker h3 {
    padding-right: 108px;
  }
  .interests h3 {
    font-size: 20px;
    font-weight: 700;
  }
  .interests p {
    color: var(--ink-muted);
  }
  .links {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  @media (max-width: 800px) {
    .interests {
      grid-template-columns: 1fr;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
