---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import StatusPill from '../components/StatusPill.astro';
import { site } from '../data/site';
---

<Base title="About" description="Megan Cheng: Hong Kong-born, Toronto-based product designer.">
  <section class="about">
    <div class="container grid">
      <div class="text">
        <StatusPill />
        <h1>Hi, I'm <strong>Megan<span class="accent">.</span></strong></h1>
        <p class="lead">
          Hong Kong-born, Toronto-based. Canadian Tire is my first full-time product design role, and where I learned
          that good design has to move a <strong>P&amp;L</strong>, not just a usability score.
        </p>
        <p>Open to product design roles in retail, banking, and AI product.</p>
        <p class="todo">[Longer bio: background, how you got into design, what you want to work on next.]</p>
        <div class="links">
          <a class="btn btn--primary" href={`mailto:${site.email}`}>Get in touch</a>
          <a class="link-arrow" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
      <Placeholder label="Headshot" ratio="4 / 5" />
    </div>
  </section>
</Base>

<style>
  .about {
    padding: clamp(64px, 10vw, 128px) 0;
  }
  .grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 48px;
    align-items: start;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }
  h1 {
    font-size: clamp(48px, 8vw, 96px);
    letter-spacing: -0.03em;
  }
  .lead {
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.3;
    max-width: 30ch;
  }
  .todo {
    color: var(--ink-muted);
    background: var(--placeholder);
    border: 1px dashed #c8c8c8;
    border-radius: var(--radius);
    padding: 12px 16px;
    font-size: 15px;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 8px;
  }
  @media (max-width: 800px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
