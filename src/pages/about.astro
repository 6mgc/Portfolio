---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import StatusPill from '../components/StatusPill.astro';
import { site } from '../data/site';

const interests = [
  { name: 'Photography', text: 'Chasing light and moments around Toronto, finding stories in everyday corners.' },
  { name: 'Music', text: "Good beats = good design flow. There's always something playing while I work." },
  { name: 'Travelling', text: 'Every new city teaches me something about how people navigate spaces and experiences.' },
  {
    name: 'Nature escapes',
    text: "Hiking Toronto's trails or getting lost in parks. My best ideas come when I step away from the screen.",
  },
  {
    name: 'Hand-building pottery',
    text: 'Getting my hands dirty with clay reminds me that the best designs come from trial, error, and embracing the messy process.',
  },
  { name: 'AI experiments', text: 'Calling myself a vibe-coder, thanks to AI!', href: '/playground' },
];
---

<Base title="About" description="Megan Cheng: Hong Kong-born, Toronto-based product designer.">
  <section class="about">
    <div class="container grid">
      <div class="text">
        <StatusPill />
        <h1>Hi, I'm <strong>Megan<span class="accent">.</span></strong></h1>
        <p class="lead">
          Hong Kong-born, Toronto-based. Canadian Tire is my first full-time product design role, and where I learned
          that good design has to move a <strong>P&amp;L</strong>, not just a usability score.
        </p>
        <p class="bio">
          As a Product Designer, I leverage my background in advertising to create user-centric e-commerce
          experiences. My East-meets-West perspective and passion for visual storytelling help me create digital
          experiences that truly connect with users.
        </p>
        <p>Open to product design roles in retail, banking, and AI product.</p>
        <div class="links">
          <a class="btn btn--primary" href={`mailto:${site.email}`}>Get in touch</a>
          <a class="link-arrow" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
      <Placeholder label="Headshot" ratio="4 / 5" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">What fuels my creativity</p>
      <h2>I design with curiosity, creativity, and <strong>a lot of <span class="accent">coffee</span></strong>.</h2>
      <ul class="interests">
        {
          interests.map((it) => (
            <li>
              <h3>{it.name}</h3>
              <p>{it.text}</p>
              {it.href && (
                <a class="link-arrow" href={it.href}>
                  <span aria-hidden="true">→</span> See the playground
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .about {
    padding: clamp(64px, 10vw, 128px) 0;
  }
  .grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 48px;
    align-items: start;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }
  h1 {
    font-size: clamp(48px, 8vw, 96px);
    letter-spacing: -0.03em;
  }
  .lead {
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.3;
    max-width: 30ch;
  }
  .bio {
    max-width: 60ch;
  }
  h2 {
    font-size: clamp(28px, 4vw, 48px);
    max-width: 22ch;
    margin: 16px 0 48px;
  }
  .interests {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 32px;
  }
  .interests li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    border-top: 1px solid var(--line-strong);
    padding-top: 20px;
  }
  .interests h3 {
    font-size: 20px;
    font-weight: 700;
  }
  .interests p {
    color: var(--ink-muted);
  }
  .links {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 8px;
  }
  @media (max-width: 800px) {
    .interests {
      grid-template-columns: 1fr;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
