---
import Base from '../layouts/Base.astro';
import StatusPill from '../components/StatusPill.astro';
import ProjectCards from '../components/ProjectCards.astro';
import { metrics } from '../data/metrics';

// Hero headline, split into words so they can rise in one after another.
// `style`: 'bold' (strong), 'accent' (strong + orange, gets the highlighter swipe).
const headline: { w: string; style?: 'bold' | 'accent' }[] = [
  { w: 'Product' },
  { w: 'designer' },
  { w: 'driving' },
  { w: 'measurable', style: 'bold' },
  { w: 'revenue', style: 'accent' },
  { w: 'through' },
  { w: 'better' },
  { w: 'retail' },
  { w: 'experiences' },
];

const principles = [
  {
    title: 'I ship inside real constraints',
    body: 'No perfect infrastructure, no problem. I design for the stack that exists today.',
  },
  {
    title: "I don't take it personally",
    body: "Designs change, whether it's a business call or a technical limit. I ask questions, talk it through with the team, and keep the work moving.",
  },
  {
    title: 'Design is a revenue lever',
    body: 'I measure impact the way the business does.',
  },
];
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <StatusPill />
      <h1 class="hero__title" aria-label={headline.map((h) => h.w).join(' ')}>
        {
          headline.map((h, i) => (
            <>
              <span class="w" aria-hidden="true" style={`--i: ${i}`}>
                {h.style === 'accent' ? (
                  <strong class="w__in accent hl">{h.w}</strong>
                ) : h.style === 'bold' ? (
                  <strong class="w__in">{h.w}</strong>
                ) : (
                  <span class="w__in">{h.w}</span>
                )}
              </span>{' '}
            </>
          ))
        }
      </h1>
      <div class="hero__foot">
        <p class="hero__sub">
          Product Designer at Canadian Tire. <strong data-count>{metrics.attributedRevenue.value}+</strong> in attributed revenue
          impact through 1:1 personalization and conversion design.
        </p>
      </div>
    </div>
  </section>

  <!-- Selected work -->
  <section class="section" id="work">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Selected work</p>
      </div>

      <ProjectCards>
        <!-- Fills the grid cell next to Nurture Seed. -->
        <div class="more-work">
          <a class="cta" href="/work">See more work <span class="cta__arrow" aria-hidden="true">→</span></a>
        </div>
      </ProjectCards>
    </div>
  </section>

  <!-- How I work -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">How I work</p>
      <ol class="principles">
        {
          principles.map((p, i) => (
            <li class:list={['principle', { 'principle--accent': i === 0 }]}>
              <span class="principle__num">0{i + 1}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- About teaser -->
  <section class="section">
    <div class="container about">
      <p class="eyebrow">About</p>
      <div>
        <p class="about__lead">
          Hi, I'm Megan. Hong Kong-born, Toronto-based. At Canadian Tire, I learned that good design
          has to move the <strong>P&amp;L</strong>, not just a usability score.
        </p>
        <p class="about__sub">Open to product design roles in retail, banking, and AI product.</p>
        <a class="cta" href="/about">More about me <span class="cta__arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: clamp(64px, 12vw, 160px) 0 clamp(64px, 10vw, 120px);
  }
  .hero__title {
    font-size: clamp(40px, 7vw, 96px);
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin: 32px 0 56px;
    max-width: 18ch;
  }
  /* Headline: each word rises out of its own line box, then a highlighter swipes under "revenue". */
  .hero__title .w {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .hero__title .w__in {
    display: inline-block;
    animation: word-rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(0.15s + var(--i) * 0.07s);
  }
  @keyframes word-rise {
    from {
      transform: translateY(105%) rotate(4deg);
    }
    to {
      transform: none;
    }
  }
  .hero__title .hl {
    background: linear-gradient(var(--accent-soft), var(--accent-soft)) no-repeat 0 88% / 0% 38%;
    animation:
      word-rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both,
      hl-swipe 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 1.2s both;
    animation-delay: calc(0.15s + var(--i) * 0.07s), 1.2s;
  }
  @keyframes hl-swipe {
    to {
      background-size: 100% 38%;
    }
  }
  .hero__sub,
  .hero :global(.pill) {
    animation: fade-up 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .hero :global(.pill) {
    animation-delay: 0.05s;
  }
  .hero__sub {
    animation-delay: 0.85s;
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__title .w__in,
    .hero__title .hl,
    .hero__sub,
    .hero :global(.pill) {
      animation: none;
    }
    .hero__title .hl {
      background-size: 100% 38%;
    }
  }
  .hero__foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
  }
  .hero__sub {
    max-width: 46ch;
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--ink-muted);
  }
  .hero__sub strong {
    color: var(--ink);
  }

  .more-work {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
  }
  @media (max-width: 800px) {
    .more-work {
      justify-content: flex-start;
    }
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 32px;
  }


  .principles {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .principle {
    border-top: 1px solid var(--line-strong);
    padding-top: 24px;
  }
  .principle--accent {
    border-top-color: var(--accent);
  }
  .principle__num {
    font-size: 13px;
    color: var(--ink-muted);
  }
  .principle h3 {
    font-size: 24px;
    line-height: 1.15;
    margin: 16px 0 12px;
  }
  .principle p {
    color: var(--ink-muted);
  }

  .about {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 32px;
  }
  .about__lead {
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    max-width: 30ch;
  }
  .about__sub {
    color: var(--ink-muted);
    margin: 24px 0 32px;
  }

  @media (max-width: 800px) {
    .principles,
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
