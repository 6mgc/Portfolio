---
import Base from '../layouts/Base.astro';
import StatusPill from '../components/StatusPill.astro';
import Metric from '../components/Metric.astro';
import Placeholder from '../components/Placeholder.astro';
import ProjectCards from '../components/ProjectCards.astro';
import { metrics } from '../data/metrics';
import { projects } from '../data/site';

const principles = [
  {
    title: 'I ship inside real constraints',
    body: 'No perfect infrastructure, no problem. I design for the stack that exists today.',
  },
  {
    title: 'I show my reasoning',
    body: 'Every case study includes the options I rejected, not just the one that shipped.',
  },
  {
    title: 'Design is a revenue lever',
    body: 'I measure impact the way the business does.',
  },
];
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <StatusPill />
      <h1 class="hero__title">
        Product designer driving <strong>measurable <span class="accent">revenue</span></strong> through better retail
        experiences
      </h1>
      <div class="hero__foot">
        <p class="hero__sub">
          Product Designer at Canadian Tire. <strong>{metrics.attributedRevenue.value}+</strong> in attributed revenue
          impact through 1:1 personalization and conversion design.
        </p>
        <div class="hero__cta">
          <a class="link-arrow" href="#work"><span aria-hidden="true">→</span> The work</a>
          <Placeholder label="Headshot" ratio="1 / 1" class="hero__photo" />
        </div>
      </div>
    </div>
  </section>

  <!-- Selected work -->
  <section class="section" id="work">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Selected work</p>
        <p class="eyebrow">{String(projects.length + 1).padStart(2, '0')} projects</p>
      </div>

      <article class="case">
        <div class="case__top">
          <div>
            <p class="eyebrow">Canadian Tire</p>
            <h2 class="case__title">Boosting retail engagement through <strong>personalized deals</strong></h2>
            <p class="case__role">
              Lead UI Designer · Conversion Rate Optimization · 1:1 Personalization · Loyalty
            </p>
          </div>
          <Metric id="conversionLift" size="lg" />
        </div>

        <p class="case__desc">
          Canadian Tire's roadmap pointed toward full AI-driven personalization, but the infrastructure wasn't there
          yet. I designed a suite of rule-based "smart components" (price-drop alerts, compact loyalty offers, urgency
          modules) to close that gap and ship measurable impact within existing constraints.
        </p>

        <div class="case__metrics">
          <Metric id="omniChannelLift" />
          <Metric id="pdpViewRate" />
          <Metric id="attributedRevenue" />
        </div>

        <Placeholder label="Case study screenshot" ratio="16 / 8" />

        <a class="link-arrow case__link" href="/work/canadian-tire">
          <span aria-hidden="true">→</span> Read the full case study
        </a>
      </article>

      <ProjectCards />
    </div>
  </section>

  <!-- How I work -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">How I work</p>
      <ol class="principles">
        {
          principles.map((p, i) => (
            <li class:list={['principle', { 'principle--accent': i === 0 }]}>
              <span class="principle__num">0{i + 1}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- About teaser -->
  <section class="section">
    <div class="container about">
      <p class="eyebrow">About</p>
      <div>
        <p class="about__lead">
          Hi, I'm Megan. Hong Kong-born, Toronto-based. Canadian Tire is my first full-time product design role, and
          where I learned that good design has to move a <strong>P&amp;L</strong>, not just a usability score.
        </p>
        <p class="about__sub">Open to product design roles in retail, banking, and AI product.</p>
        <a class="link-arrow" href="/about"><span aria-hidden="true">→</span> More about me</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: clamp(64px, 12vw, 160px) 0 clamp(64px, 10vw, 120px);
  }
  .hero__title {
    font-size: clamp(40px, 7vw, 96px);
    letter-spacing: -0.045em;
    line-height: 0.95;
    margin: 32px 0 56px;
    max-width: 18ch;
  }
  .hero__foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
  }
  .hero__sub {
    max-width: 46ch;
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--ink-muted);
  }
  .hero__sub strong {
    color: var(--ink);
  }
  .hero__cta {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .hero__cta :global(.hero__photo) {
    width: 64px;
    border: 1px solid var(--accent);
    font-size: 9px;
    padding: 4px;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .case {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: clamp(24px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .case__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    flex-wrap: wrap;
  }
  .case__title {
    font-size: clamp(28px, 4vw, 44px);
    margin: 12px 0 16px;
    max-width: 18ch;
  }
  .case__role {
    font-size: 14px;
    color: var(--ink-muted);
  }
  .case__desc {
    max-width: 62ch;
  }
  .case__metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .case__link {
    align-self: flex-start;
  }

  .principles {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .principle {
    border-top: 1px solid var(--line-strong);
    padding-top: 24px;
  }
  .principle--accent {
    border-top-color: var(--accent);
  }
  .principle__num {
    font-size: 13px;
    color: var(--ink-muted);
  }
  .principle h3 {
    font-size: 24px;
    line-height: 1.15;
    margin: 16px 0 12px;
  }
  .principle p {
    color: var(--ink-muted);
  }

  .about {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 32px;
  }
  .about__lead {
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    max-width: 30ch;
  }
  .about__sub {
    color: var(--ink-muted);
    margin: 24px 0 32px;
  }

  @media (max-width: 800px) {
    .case__metrics,
    .principles,
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
