---
import Base from '../layouts/Base.astro';
import StatusPill from '../components/StatusPill.astro';
import ProjectCards from '../components/ProjectCards.astro';
import { metrics } from '../data/metrics';
import { projects } from '../data/site';

const principles = [
  {
    title: 'I ship inside real constraints',
    body: 'No perfect infrastructure, no problem. I design for the stack that exists today.',
  },
  {
    title: "I don't take it personally",
    body: "Designs change, whether it's a business call or a technical limit. I ask questions, talk it through with the team, and keep the work moving.",
  },
  {
    title: 'Design is a revenue lever',
    body: 'I measure impact the way the business does.',
  },
];
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <StatusPill />
      <h1 class="hero__title">
        Product designer driving <strong>measurable <span class="accent">revenue</span></strong> through better retail
        experiences
      </h1>
      <div class="hero__foot">
        <p class="hero__sub">
          Product Designer at Canadian Tire. <strong>{metrics.attributedRevenue.value}+</strong> in attributed revenue
          impact through 1:1 personalization and conversion design.
        </p>
        <div class="hero__cta">
          <a class="cta" href="#work">The work <span class="cta__arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected work -->
  <section class="section" id="work">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Selected work</p>
        <p class="eyebrow">{String(projects.length).padStart(2, '0')} projects</p>
      </div>

      <ProjectCards />
    </div>
  </section>

  <!-- How I work -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">How I work</p>
      <ol class="principles">
        {
          principles.map((p, i) => (
            <li class:list={['principle', { 'principle--accent': i === 0 }]}>
              <span class="principle__num">0{i + 1}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- About teaser -->
  <section class="section">
    <div class="container about">
      <p class="eyebrow">About</p>
      <div>
        <p class="about__lead">
          Hi, I'm Megan. Hong Kong-born, Toronto-based. At Canadian Tire, I learned that good design
          has to move the <strong>P&amp;L</strong>, not just a usability score.
        </p>
        <p class="about__sub">Open to product design roles in retail, banking, and AI product.</p>
        <a class="cta" href="/about">More about me <span class="cta__arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: clamp(64px, 12vw, 160px) 0 clamp(64px, 10vw, 120px);
  }
  .hero__title {
    font-size: clamp(40px, 7vw, 96px);
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin: 32px 0 56px;
    max-width: 18ch;
  }
  .hero__foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
  }
  .hero__sub {
    max-width: 46ch;
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--ink-muted);
  }
  .hero__sub strong {
    color: var(--ink);
  }
  .hero__cta {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 32px;
  }


  .principles {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .principle {
    border-top: 1px solid var(--line-strong);
    padding-top: 24px;
  }
  .principle--accent {
    border-top-color: var(--accent);
  }
  .principle__num {
    font-size: 13px;
    color: var(--ink-muted);
  }
  .principle h3 {
    font-size: 24px;
    line-height: 1.15;
    margin: 16px 0 12px;
  }
  .principle p {
    color: var(--ink-muted);
  }

  .about {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 32px;
  }
  .about__lead {
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    max-width: 30ch;
  }
  .about__sub {
    color: var(--ink-muted);
    margin: 24px 0 32px;
  }

  @media (max-width: 800px) {
    .principles,
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
