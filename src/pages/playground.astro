---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';

interface Experiment {
  name: string;
  description: string;
  highlights?: { heading: string; items: { label: string; text: string }[] };
  inspiration?: { src: string; alt: string; caption: string };
  url: string;
  // `src` is a path under public/; without it the shot renders as a placeholder.
  shots: { label: string; ratio: string; src?: string }[];
}

const experiments: Experiment[] = [
  {
    name: 'Daily YES! Card: TVB Edition',
    description:
      'Daily YES! Card is a digital revival of a beloved Hong Kong childhood ritual. It\'s a "Just for Fun" web app that combines the nostalgia of Yes! Card vending machines with the legendary, often meme-worthy phrases (金句) from classic TVB dramas.',
    highlights: {
      heading: 'The HK Soul',
      items: [
        { label: 'Virtual Gashapon', text: 'Recreates the childhood thrill of "pulling" a collectible card from a stationery shop machine.' },
        { label: 'Prime-Time Wisdom', text: 'Features the iconic dialogue we all grew up hearing during the 8:30 PM dinner slot.' },
        { label: 'Tech meets Canto-pop', text: 'A playful bridge between 90s/00s nostalgia and modern AI.' },
      ],
    },
    inspiration: {
      src: '/images/yes-card-machine.webp',
      alt: 'An orange YES! Card vending machine in a Hong Kong shop, with a coin slot, a white turning knob, and a big yellow pointing hand.',
      caption: 'The inspiration: an original YES! Card machine.',
    },
    url: 'https://dailyyescard.vercel.app/',
    shots: [
      { label: 'Daily YES! Card: vending machine', ratio: '1 / 1' },
      { label: 'Daily YES! Card: card reveal', ratio: '1 / 1' },
    ],
  },
  {
    name: 'Moody Pod',
    description:
      'A nostalgic, iPod-inspired web app that recommends songs based on your current mood. Users type how they\'re feeling, and the app uses AI to suggest a song that matches their emotional state. It\'s a simple two-page experience designed to feel like using a classic Apple iPod.',
    url: 'https://moodypod.vercel.app/',
    shots: [
      {
        label: 'Moody Pod: an iPod-style screen asks "How are you feeling?" above a click wheel',
        ratio: '16 / 9',
        src: '/images/moody-pod.webp',
      },
    ],
  },
];
---

<Base title="AI Playground" description="Small AI experiments by Megan Cheng: Daily YES! Card and Moody Pod.">
  <section class="intro">
    <div class="container">
      <p class="eyebrow">AI Playground</p>
      <h1>Welcome to my AI <strong class="accent">playground</strong></h1>
    </div>
  </section>

  {
    experiments.map((x, i) => (
      <section class="section">
        <div class="container exp">
          <div class="exp__head">
            <p class="eyebrow">0{i + 1} / 0{experiments.length}</p>
            <h2>{x.name}</h2>
            {x.inspiration && (
              <figure class="inspo">
                <img src={x.inspiration.src} alt={x.inspiration.alt} width="360" height="480" loading="lazy" decoding="async" />
                <figcaption>{x.inspiration.caption}</figcaption>
              </figure>
            )}
          </div>
          <div class="exp__body">
            <p class="exp__desc">{x.description}</p>
            {x.highlights && (
              <div class="exp__hl">
                <p class="eyebrow">{x.highlights.heading}</p>
                <ul>
                  {x.highlights.items.map((h) => (
                    <li>
                      <strong>{h.label}.</strong> {h.text}
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {x.url ? (
              <a class="cta" href={x.url} target="_blank" rel="noopener">
                Try it out <span class="cta__arrow" aria-hidden="true">→</span>
              </a>
            ) : (
              <span class="cta cta--pending">
                Try it out [add link]
              </span>
            )}
          </div>
          <div class:list={['exp__shots', { 'exp__shots--two': x.shots.length > 1 }]}>
            {x.shots.map((s) => (
              s.src ? (
                <img class="shot" src={s.src} alt={s.label} style={`aspect-ratio: ${s.ratio}`} loading="lazy" decoding="async" />
              ) : (
                <Placeholder label={s.label} ratio={s.ratio} />
              )
            ))}
          </div>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .intro {
    padding: clamp(64px, 12vw, 160px) 0 clamp(48px, 8vw, 96px);
  }
  h1 {
    font-size: clamp(44px, 8vw, 96px);
    letter-spacing: -0.03em;
    margin: 20px 0 0;
    max-width: 14ch;
  }

  .exp {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 32px 48px;
  }
  .exp__head h2 {
    font-size: clamp(28px, 3.4vw, 40px);
    margin-top: 12px;
  }
  .inspo {
    margin: 32px 0 0;
    max-width: 240px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .inspo img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  .inspo figcaption {
    font-size: 13px;
    color: var(--ink-muted);
  }
  .exp__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .exp__desc {
    max-width: 62ch;
  }
  .exp__hl ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--ink-muted);
  }
  .exp__hl strong {
    color: var(--ink);
  }
  .exp__shots {
    grid-column: 1 / -1;
    display: grid;
    gap: 16px;
  }
  .shot {
    width: 100%;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .exp__shots--two {
    grid-template-columns: 1fr 1fr;
  }

  @media (max-width: 800px) {
    .exp,
    .exp__shots--two {
      grid-template-columns: 1fr;
    }
  }
</style>
