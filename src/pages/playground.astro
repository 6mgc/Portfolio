---
import Base from '../layouts/Base.astro';

/*
 * AI Playground: each experiment reads top to bottom: title, description, highlights,
 * "Try it Out", then large screenshots (and the inspiration photo, where there is one).
 */

interface Experiment {
  slug: string;
  name: string;
  short: string;
  description: string;
  highlights?: { heading: string; items: { label: string; text: string }[] };
  // The screenshot shown when there are no `shots`.
  image: Img;
  // Screenshots shown side by side.
  shots?: Img[];
  // What inspired it, shown small under the details.
  inspiration?: Img;
  url: string;
}
interface Img {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
}

const experiments: Experiment[] = [
  {
    slug: 'yes-card',
    name: 'Daily YES! Card: TVB Edition',
    short: 'Daily YES! Card',
    description:
      'Daily YES! Card is a digital revival of a beloved Hong Kong childhood ritual. It\'s a "Just for Fun" web app that combines the nostalgia of Yes! Card vending machines with the legendary, often meme-worthy phrases (金句) from classic TVB dramas.',
    highlights: {
      heading: 'The HK Soul',
      items: [
        { label: 'Virtual Gashapon', text: 'Recreates the childhood thrill of "pulling" a collectible card from a stationery shop machine.' },
        { label: 'Prime-Time Wisdom', text: 'Features the iconic dialogue we all grew up hearing during the 8:30 PM dinner slot.' },
        { label: 'Tech meets Canto-pop', text: 'A playful bridge between 90s/00s nostalgia and modern AI.' },
      ],
    },
    image: {
      src: '/images/yes-card-app.webp',
      alt: 'Daily YES! Card: a red vending machine with a yellow knob and a "轉轉佢!" button.',
      width: 1000,
      height: 970,
    },
    shots: [
      {
        src: '/images/yes-card-app.webp',
        alt: 'The machine: a red Daily YES! Card vending machine. Its screen says "撳落去，睇下今日有咩錦囊傍身！" above a yellow knob and a "轉轉佢!" button.',
        width: 1000,
        height: 970,
      },
      {
        src: '/images/yes-card-reveal.webp',
        alt: 'The card reveal: a shimmering card with the TVB quote "「一家人，齊齊整整先係最重要。」" from 《真情》, with download, "再抽一張" and share buttons.',
        width: 1000,
        height: 970,
      },
    ],
    inspiration: {
      src: '/images/yes-card-machine.webp',
      alt: 'An orange YES! Card vending machine in a Hong Kong shop, with a coin slot, a white turning knob, and a big yellow pointing hand.',
      width: 360,
      height: 480,
      caption: 'The inspiration: an original YES! Card machine.',
    },
    url: 'https://dailyyescard.vercel.app/',
  },
  {
    slug: 'moody-pod',
    name: 'Moody Pod',
    short: 'Moody Pod',
    description:
      'A nostalgic, iPod-inspired web app that recommends songs based on your current mood. Users type how they\'re feeling, and the app uses AI to suggest a song that matches their emotional state. It\'s a simple two-page experience designed to feel like using a classic Apple iPod.',
    image: {
      src: '/images/moody-pod.webp',
      alt: 'Moody Pod: an iPod-style screen asks "How are you feeling?" above a click wheel.',
      width: 1600,
      height: 900,
    },
    url: 'https://moodypod.vercel.app/',
  },
];
---

<Base title="AI Playground" description="Small AI experiments by Megan Cheng: Daily YES! Card and Moody Pod.">
  <section class="head">
    <div class="container">
      <p class="eyebrow">AI Playground</p>
      <h1>Welcome to my AI <strong class="accent">playground</strong></h1>
      <p class="count eyebrow">{String(experiments.length).padStart(2, '0')} experiments</p>
    </div>
  </section>

  {
    experiments.map((x) => (
      <section class="section exp-section">
        <div class="container exp">
          <h2>{x.name}</h2>
          <p class="exp__desc">{x.description}</p>
          {x.highlights && (
            <div class="exp__hl">
              <p class="eyebrow">{x.highlights.heading}</p>
              <ul>
                {x.highlights.items.map((h) => (
                  <li>
                    <strong>{h.label}.</strong> {h.text}
                  </li>
                ))}
              </ul>
            </div>
          )}
          <a class="cta cta--primary" href={x.url} target="_blank" rel="noopener">
            Try it out <span class="cta__arrow" aria-hidden="true">→</span>
          </a>
          <div class:list={['exp__media', { 'exp__media--two': x.shots && x.shots.length > 1 }]}>
            {(x.shots ?? [x.image]).map((sh) => (
              <img class="shot" src={sh.src} alt={sh.alt} width={sh.width} height={sh.height} loading="lazy" decoding="async" />
            ))}
          </div>
          {x.inspiration && (
            <figure class="inspo">
              <img src={x.inspiration.src} alt={x.inspiration.alt} width={x.inspiration.width} height={x.inspiration.height} loading="lazy" decoding="async" />
              <figcaption>{x.inspiration.caption}</figcaption>
            </figure>
          )}
        </div>
      </section>
    ))
  }
</Base>

<style>
  /* Same page head as the Work page. */
  .head {
    padding: clamp(64px, 10vw, 128px) 0 0;
  }
  h1 {
    font-size: clamp(44px, 8vw, 96px);
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin: 20px 0 24px;
    max-width: 14ch;
  }

  /* Each experiment, top to bottom: title, description, highlights, button, screenshots. */
  .exp-section + .exp-section {
    padding-top: 0;
  }
  .exp {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .exp h2 {
    font-size: clamp(28px, 3.4vw, 40px);
  }
  .exp__desc {
    margin-top: 16px;
    max-width: 62ch;
  }
  .exp__hl {
    margin-top: 28px;
  }
  .exp__hl ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 72ch;
    color: var(--ink-muted);
  }
  .exp__hl strong {
    color: var(--ink);
  }
  .exp .cta {
    margin-top: 32px;
  }
  .exp__media {
    display: grid;
    gap: 16px;
    width: 100%;
    margin-top: 40px;
  }
  .exp__media--two {
    grid-template-columns: 1fr 1fr;
  }
  .shot {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  .inspo {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 24px 0 0;
  }
  .inspo img {
    width: min(280px, 100%);
    height: auto;
    border-radius: var(--radius);
  }
  .inspo figcaption {
    font-size: 13px;
    color: var(--ink-muted);
  }

  @media (max-width: 720px) {
    .exp__media--two {
      grid-template-columns: 1fr;
    }
  }
</style>
