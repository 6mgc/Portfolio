---
import { nav, site } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__brand">{site.shortName}</a>
    <nav aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="nav__email" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    position: relative;
    z-index: 2;
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 72px;
    flex-wrap: wrap;
  }
  .nav__brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    text-decoration: none;
  }
  ul {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a,
  .nav__email {
    font-size: 15px;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.15s;
  }
  nav a:hover,
  .nav__email:hover,
  nav a[aria-current='page'] {
    border-color: var(--accent);
  }
  .nav__email {
    color: var(--ink-muted);
  }
  @media (max-width: 860px) {
    .nav__email {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .nav__inner {
      padding-top: 16px;
      padding-bottom: 16px;
    }
    ul {
      gap: 16px;
      flex-wrap: wrap;
    }
    nav a {
      font-size: 14px;
    }
  }
</style>
