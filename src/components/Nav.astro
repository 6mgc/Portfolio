---
import { nav, site } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '').replace(/\.html$/, '') || '/';
// Case study pages count as "Work".
const isCurrent = (href: string) => href === path || (href === '/#work' && path.startsWith('/work/'));
---

<header class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__brand" aria-label={`${site.name}, home`}>Megan<span class="accent">.</span></a>
    <nav aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} data-label={item.label} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button class="theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch to dark mode">
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" />
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <circle cx="12" cy="12" r="4.2" />
        <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
      </svg>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const sync = () => {
    const dark = document.documentElement.dataset.mode === 'dark';
    const label = dark ? 'Switch to light mode' : 'Switch to dark mode';
    btn?.setAttribute('aria-label', label);
    btn?.setAttribute('title', label);
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#121212' : '#ffffff');
  };
  sync();
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.mode === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.mode = next;
    (window as unknown as { __saveTheme?: (v: string) => void }).__saveTheme?.(next);
    sync();
  });
</script>

<style>
  /* Always visible: sticks to the top of the viewport. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 72px;
    flex-wrap: wrap;
  }
  .nav__brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    text-decoration: none;
  }
  ul {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-size: 15px;
    text-decoration: none;
  }
  /* Hover: bold + accent. Current page: bold. The hidden bold copy reserves the width so nothing shifts. */
  nav a {
    display: inline-grid;
    transition: color 0.15s;
  }
  nav a::after {
    content: attr(data-label);
    font-weight: 700;
    height: 0;
    overflow: hidden;
    visibility: hidden;
  }
  nav a:hover,
  nav a:focus-visible {
    color: var(--accent);
    font-weight: 700;
  }
  nav a[aria-current='page'] {
    font-weight: 700;
  }
  /* Theme switch: moon in light mode, sun in dark mode. */
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, transform 0.3s ease;
  }
  .theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .theme-toggle:active {
    transform: rotate(-20deg) scale(0.94);
  }
  .theme-toggle svg {
    width: 20px;
    height: 20px;
  }
  .icon-sun,
  :global([data-mode='dark']) .icon-moon {
    display: none;
  }
  :global([data-mode='dark']) .icon-sun {
    display: block;
  }
  @media (max-width: 520px) {
    .nav__inner {
      padding-top: 16px;
      padding-bottom: 16px;
    }
    ul {
      gap: 16px;
      flex-wrap: wrap;
    }
    nav a {
      font-size: 14px;
    }
  }
</style>
