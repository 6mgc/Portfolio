---
import { nav, site } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '').replace(/\.html$/, '') || '/';
// Case study pages count as "Work".
const isCurrent = (href: string) => href === path || (href === '/#work' && path.startsWith('/work/'));
---

<header class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__brand" aria-label={`${site.name}, home`}>Megan<span class="accent">.</span></a>
    <nav aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} data-label={item.label} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="nav__email" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</header>

<style>
  /* Always visible: sticks to the top of the viewport. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 72px;
    flex-wrap: wrap;
  }
  .nav__brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    text-decoration: none;
  }
  ul {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a,
  .nav__email {
    font-size: 15px;
    text-decoration: none;
  }
  /* Hover: bold + accent. Current page: bold. The hidden bold copy reserves the width so nothing shifts. */
  nav a {
    display: inline-grid;
    transition: color 0.15s;
  }
  nav a::after {
    content: attr(data-label);
    font-weight: 700;
    height: 0;
    overflow: hidden;
    visibility: hidden;
  }
  nav a:hover,
  nav a:focus-visible {
    color: var(--accent);
    font-weight: 700;
  }
  nav a[aria-current='page'] {
    font-weight: 700;
  }
  .nav__email {
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.15s;
  }
  .nav__email:hover {
    border-color: var(--accent);
  }
  .nav__email {
    color: var(--ink-muted);
  }
  @media (max-width: 860px) {
    .nav__email {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .nav__inner {
      padding-top: 16px;
      padding-bottom: 16px;
    }
    ul {
      gap: 16px;
      flex-wrap: wrap;
    }
    nav a {
      font-size: 14px;
    }
  }
</style>
