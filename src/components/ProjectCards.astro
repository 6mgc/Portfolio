---
import Placeholder from './Placeholder.astro';
import { projects, caseStudyProjects } from '../data/site';

interface Props {
  // Slug of the project to leave out (the case study you're on).
  exclude?: string;
  // 'featured': homepage, two cards then three per row. 3: More work rows, case studies only.
  layout?: 'featured' | 3;
}
const { exclude, layout = 'featured' } = Astro.props;
const shown = (layout === 'featured' ? projects : caseStudyProjects).filter((p) => p.slug !== exclude);
---

<div class:list={['cards', `cards--${layout}`]}>
  {
    shown.map((p) => {
      const Tag = p.comingSoon ? 'div' : 'a';
      return (
      <Tag class:list={['card', { 'card--soon': p.comingSoon }]} href={p.comingSoon ? undefined : `/work/${p.slug}`}>
        <div class="card__thumb">
          {p.thumb ? (
            <img src={p.thumb} alt="" width="1200" height="900" loading="lazy" decoding="async" />
          ) : (
            p.comingSoon ? (
              <div class="card__soon-thumb" aria-hidden="true" />
            ) : (
              <Placeholder label={`${p.name} thumbnail`} ratio="4 / 3" />
            )
          )}
        </div>
        <p class="card__title">
          <span class="card__hl">
            <span class="card__name">{p.name}</span>
            <span class="card__sep" aria-hidden="true">/</span>
            {p.title}
          </span>
        </p>
        {p.comingSoon ? (
          <p class="card__meta">
            <span class="card__status">Coming soon</span>
          </p>
        ) : (
          <p class="card__meta">
            {p.role}
            <span class="card__sep" aria-hidden="true">/</span>
            <strong>{p.impact}</strong>
          </p>
        )}
      </Tag>
      );
    })
  }
</div>

<style>
  .cards {
    display: grid;
    gap: 48px 32px;
    margin-top: 24px;
  }
  /* Homepage: first two cards share a row, the rest sit three to a row (6-column grid). */
  .cards--featured {
    grid-template-columns: repeat(6, 1fr);
  }
  .cards--featured > :global(*) {
    grid-column: span 2;
  }
  .cards--featured > :global(:nth-child(-n + 2)) {
    grid-column: span 3;
  }
  .cards--3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
  }
  .card__thumb {
    overflow: hidden;
    border-radius: var(--radius);
    margin-bottom: 8px;
  }
  .card__thumb img {
    display: block;
    height: auto;
  }
  .card__thumb img,
  .card__thumb :global(.placeholder) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:hover .card__thumb img,
  .card:hover .card__thumb :global(.placeholder) {
    transform: scale(1.03);
  }
  .card__title {
    font-family: var(--font-display);
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .card__name {
    font-weight: 700;
  }
  .card__sep {
    color: var(--ink-muted);
    margin: 0 0.4em;
  }
  .card__meta {
    font-size: 15px;
    color: var(--ink-muted);
  }
  .card__meta strong {
    color: var(--ink);
    font-weight: 600;
  }
  /* Highlighter pen: a light-orange band sweeps across the lower part of each line on hover. */
  .card__hl {
    background-image: linear-gradient(var(--accent-soft), var(--accent-soft));
    background-repeat: no-repeat;
    background-position: 0 88%;
    background-size: 0% 55%;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-size 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:not(.card--soon):hover .card__hl,
  .card:focus-visible .card__hl {
    background-size: 100% 55%;
  }
  /* Coming soon: a quiet panel instead of a thumbnail. */
  .card__soon-thumb {
    aspect-ratio: 4 / 3;
    border: 1px dashed #c8c8c8;
    border-radius: var(--radius);
    background: var(--placeholder);
  }
  .card__status {
    display: inline-flex;
    padding: 2px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
  }
  @media (max-width: 800px) {
    .cards--featured,
    .cards--3 {
      grid-template-columns: 1fr;
    }
    .cards--featured > :global(*),
    .cards--featured > :global(:nth-child(-n + 2)) {
      grid-column: auto;
    }
  }
</style>
