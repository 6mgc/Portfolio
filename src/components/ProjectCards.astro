---
import { projects } from '../data/site';
---

<div class="cards">
  {
    projects.map((p, i) => {
      const Tag = p.href ? 'a' : 'div';
      return (
        <Tag class:list={['card', { 'card--link': p.href }]} href={p.href}>
          <p class="eyebrow">0{i + 2}</p>
          <p class="card__name">{p.name}</p>
          <p class="card__role">{p.role}</p>
          <p class="card__status">{p.href ? '→ Read the case study' : 'Case study coming soon'}</p>
        </Tag>
      );
    })
  }
</div>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 24px;
  }
  .card {
    display: flex;
    flex-direction: column;
    border: 1px dashed #bdbdbd;
    border-radius: var(--radius);
    padding: 28px;
    text-decoration: none;
  }
  .card--link {
    border-style: solid;
    border-color: var(--line-strong);
    transition: border-color 0.15s;
  }
  .card--link:hover {
    border-color: var(--accent);
  }
  .card__name {
    font-size: 24px;
    margin: 12px 0 4px;
  }
  .card__role {
    font-size: 14px;
    color: var(--ink-muted);
  }
  .card__status {
    margin-top: 32px;
    font-size: 13px;
    color: var(--ink-muted);
  }
  @media (max-width: 800px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
