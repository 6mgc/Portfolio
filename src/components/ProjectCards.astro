---
import { projects } from '../data/site';

interface Props {
  // Slug of the project to leave out (the featured card on the homepage, or the current case study).
  exclude: string;
}
const { exclude } = Astro.props;
const shown = projects.map((p, i) => ({ ...p, num: String(i + 1).padStart(2, '0') })).filter((p) => p.slug !== exclude);
---

<div class="cards">
  {
    shown.map((p) => (
      <a class="card" href={`/work/${p.slug}`}>
        <p class="eyebrow">{p.num}</p>
        <p class="card__name">{p.name}</p>
        <p class="card__role">{p.role}</p>
        <p class="card__status">→ Read the case study</p>
      </a>
    ))
  }
</div>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 24px;
  }
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .card:hover {
    border-color: var(--accent);
  }
  .card__name {
    font-size: 24px;
    margin: 12px 0 4px;
  }
  .card__role {
    font-size: 14px;
    color: var(--ink-muted);
  }
  .card__status {
    margin-top: 32px;
    font-size: 13px;
    color: var(--ink-muted);
  }
  @media (max-width: 800px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
