---
import Placeholder from './Placeholder.astro';
import { projects, caseStudyProjects, featuredProjects } from '../data/site';

interface Props {
  // Slug of the project to leave out (the case study you're on).
  exclude?: string;
  // 'featured': homepage selection, two per row. 'all': Work page, every project, two per row.
  // 3: More work rows on case study pages, case studies only.
  layout?: 'featured' | 'all' | 3;
}
const { exclude, layout = 'featured' } = Astro.props;
const source = layout === 'featured' ? featuredProjects : layout === 'all' ? projects : caseStudyProjects;
const shown = source.filter((p) => p.slug !== exclude);
---

<div class:list={['cards', `cards--${layout}`]}>
  {
    shown.map((p) => {
      const Tag = p.comingSoon ? 'div' : 'a';
      return (
      <Tag class:list={['card', { 'card--soon': p.comingSoon }]} href={p.comingSoon ? undefined : `/work/${p.slug}`}>
        <div class="card__thumb">
          {p.thumb ? (
            <img src={p.thumb} alt="" width="1200" height="900" loading="lazy" decoding="async" />
          ) : (
            p.comingSoon ? (
              <div class="card__soon-thumb">
                <span class="soon-sticker">
                  <span class="soon-sticker__emoji" aria-hidden="true">🌱</span>
                  <span class="soon-sticker__text">In progress</span>
                </span>
              </div>
            ) : (
              <Placeholder label={`${p.name} thumbnail`} ratio="4 / 3" />
            )
          )}
        </div>
        <p class="card__title">
          <span class="card__hl">
            <span class="card__name">{p.name}</span>
            <span class="card__sep" aria-hidden="true">/</span>
            {p.title}
          </span>
        </p>
        {p.comingSoon ? (
          <p class="card__meta">
            <span class="card__status">Coming soon</span>
          </p>
        ) : (
          <p class="card__meta">
            {p.role}
            <span class="card__sep" aria-hidden="true">/</span>
            <strong>{p.impact}</strong>
          </p>
        )}
      </Tag>
      );
    })
  }
  <!-- Extra grid items, e.g. the homepage's "See more work" link. -->
  <slot />
</div>

<style>
  .cards {
    display: grid;
    gap: 48px 32px;
    margin-top: 24px;
  }
  /* Homepage and Work page: two cards per row. */
  .cards--featured,
  .cards--all {
    grid-template-columns: repeat(2, 1fr);
  }
  .cards--3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
  }
  .card__thumb {
    overflow: hidden;
    border-radius: var(--radius);
    margin-bottom: 8px;
  }
  .card__thumb img {
    display: block;
    height: auto;
  }
  .card__thumb img,
  .card__thumb :global(.placeholder) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:hover .card__thumb img,
  .card:hover .card__thumb :global(.placeholder) {
    transform: scale(1.03);
  }
  .card__title {
    font-family: var(--font-display);
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .card__name {
    font-weight: 700;
  }
  .card__sep {
    color: var(--ink-muted);
    margin: 0 0.4em;
  }
  .card__meta {
    font-size: 15px;
    color: var(--ink-muted);
  }
  .card__meta strong {
    color: var(--ink);
    font-weight: 600;
  }
  /* Highlighter pen: a light-orange band sweeps across the lower part of each line on hover. */
  .card__hl {
    background-image: linear-gradient(var(--accent-soft), var(--accent-soft));
    background-repeat: no-repeat;
    background-position: 0 88%;
    background-size: 0% 55%;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-size 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:not(.card--soon):hover .card__hl,
  .card:focus-visible .card__hl {
    background-size: 100% 55%;
  }
  /* Coming soon: a warm panel with a tilted "In progress" sticker that wiggles on hover. */
  .card__soon-thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background: var(--soon-bg) radial-gradient(circle, var(--soon-dot) 1.5px, transparent 1.5px) 0 0 / 22px 22px;
  }
  .soon-sticker {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: clamp(132px, 34%, 180px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    border: 6px solid #ffffff;
    box-shadow:
      0 2px 4px rgb(17 17 17 / 0.12),
      0 12px 28px rgb(17 17 17 / 0.16);
    transform: rotate(-8deg);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .soon-sticker__emoji {
    font-size: clamp(34px, 4vw, 48px);
    line-height: 1;
  }
  .soon-sticker__text {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(15px, 1.5vw, 19px);
    letter-spacing: -0.01em;
  }
  .card--soon:hover .soon-sticker {
    animation: sticker-wiggle 0.6s ease-in-out;
  }
  @keyframes sticker-wiggle {
    0%, 100% { transform: rotate(-8deg) scale(1); }
    30% { transform: rotate(4deg) scale(1.06); }
    60% { transform: rotate(-12deg) scale(1.03); }
  }
  @media (prefers-reduced-motion: reduce) {
    .card--soon:hover .soon-sticker {
      animation: none;
    }
  }
  .card__status {
    display: inline-flex;
    padding: 2px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
  }
  @media (max-width: 800px) {
    .cards--featured,
    .cards--all,
    .cards--3 {
      grid-template-columns: 1fr;
    }
  }
</style>
