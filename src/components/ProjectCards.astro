---
import Placeholder from './Placeholder.astro';
import { projects } from '../data/site';

interface Props {
  // Slug of the project to leave out (the case study you're on).
  exclude?: string;
  columns?: 2 | 3;
}
const { exclude, columns = 2 } = Astro.props;
const shown = projects.filter((p) => p.slug !== exclude);
---

<div class:list={['cards', `cards--${columns}`]}>
  {
    shown.map((p) => (
      <a class="card" href={`/work/${p.slug}`}>
        <div class="card__thumb">
          {p.thumb ? (
            <img src={p.thumb} alt="" loading="lazy" decoding="async" />
          ) : (
            <Placeholder label={`${p.name} thumbnail`} ratio="4 / 3" />
          )}
        </div>
        <p class="card__title">
          <span class="card__hl">
            <span class="card__name">{p.name}</span>
            <span class="card__sep" aria-hidden="true">/</span>
            {p.title}
          </span>
        </p>
        <p class="card__meta">
          {p.role}
          <span class="card__sep" aria-hidden="true">/</span>
          <strong>{p.impact}</strong>
        </p>
      </a>
    ))
  }
</div>

<style>
  .cards {
    display: grid;
    gap: 48px 32px;
    margin-top: 24px;
  }
  .cards--2 {
    grid-template-columns: repeat(2, 1fr);
  }
  .cards--3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
  }
  .card__thumb {
    overflow: hidden;
    border-radius: var(--radius);
    margin-bottom: 8px;
  }
  .card__thumb img {
    display: block;
  }
  .card__thumb img,
  .card__thumb :global(.placeholder) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:hover .card__thumb img,
  .card:hover .card__thumb :global(.placeholder) {
    transform: scale(1.03);
  }
  .card__title {
    font-family: var(--font-display);
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .card__name {
    font-weight: 700;
  }
  .card__sep {
    color: var(--ink-muted);
    margin: 0 0.4em;
  }
  .card__meta {
    font-size: 15px;
    color: var(--ink-muted);
  }
  .card__meta strong {
    color: var(--ink);
    font-weight: 600;
  }
  /* Highlighter pen: a light-orange band sweeps across the lower part of each line on hover. */
  .card__hl {
    background-image: linear-gradient(var(--accent-soft), var(--accent-soft));
    background-repeat: no-repeat;
    background-position: 0 88%;
    background-size: 0% 55%;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-size 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:hover .card__hl,
  .card:focus-visible .card__hl {
    background-size: 100% 55%;
  }
  @media (max-width: 800px) {
    .cards--2,
    .cards--3 {
      grid-template-columns: 1fr;
    }
  }
</style>
