---
import { projects } from '../data/site';

interface Props {
  // Slug of the project to leave out (the featured card on the homepage, or the current case study).
  exclude: string;
}
const { exclude } = Astro.props;
const shown = projects.map((p, i) => ({ ...p, num: String(i + 1).padStart(2, '0') })).filter((p) => p.slug !== exclude);
---

<div class="cards">
  {
    shown.map((p) => (
      <a class="card" href={`/work/${p.slug}`}>
        <p class="card__top">
          <span class="eyebrow">{p.num}</span>
          <span class="card__arrow" aria-hidden="true">→</span>
        </p>
        <p class="card__name">{p.name}</p>
        <p class="card__role">{p.role}</p>
      </a>
    ))
  }
</div>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 24px;
  }
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .card:hover {
    border-color: var(--accent);
  }
  .card__name {
    font-family: var(--font-display);
    font-size: 24px;
    margin: 12px 0 4px;
  }
  .card__role {
    font-size: 14px;
    color: var(--ink-muted);
  }
  .card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .card__arrow {
    transition: transform 0.35s ease;
  }
  .card:hover .card__arrow {
    transform: translateX(4px);
  }
  @media (max-width: 800px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
