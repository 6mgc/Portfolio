---
/*
 * Site-wide motion and interaction layer.
 * - Custom cursor (desktop, fine pointers only): a dot that grows over links, and becomes a labelled
 *   camera-viewfinder frame over project cards ("View", "Locked", "Soon").
 * - Magnetic buttons: CTAs and icon buttons lean toward the pointer.
 * - Scroll reveals: content rises in as it enters the viewport; big numbers count up.
 * - Easter eggs: a console note, and a shutter flash after clicking the header name 5 times.
 * Everything is progressive: without JS, or with reduced motion, the page is complete and static.
 */
---

<div class="cursor" aria-hidden="true">
  <span class="cursor__dot"></span>
  <span class="cursor__frame">
    <i></i><i></i><i></i><i></i>
    <span class="cursor__label"></span>
  </span>
</div>
<div class="shutter" aria-hidden="true"></div>
<p class="shutter-toast" role="status" aria-live="polite"></p>

<style is:global>
  /* ---------- Cursor ---------- */
  .cursor {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: 100;
    pointer-events: none;
    display: none;
  }
  html.has-cursor .cursor {
    display: block;
  }
  html.has-cursor,
  html.has-cursor a,
  html.has-cursor button,
  html.has-cursor [data-cursor] {
    cursor: none;
  }
  html.has-cursor input,
  html.has-cursor textarea {
    cursor: text;
  }
  .cursor__dot {
    position: absolute;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: var(--accent);
    transition:
      width 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      height 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      margin 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      background-color 0.25s,
      opacity 0.2s;
  }
  .cursor.is-link .cursor__dot {
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    border: 1.5px solid var(--accent);
  }
  .cursor.is-text .cursor__dot,
  .cursor.is-hidden .cursor__dot,
  .cursor.is-frame .cursor__dot {
    opacity: 0;
  }
  /* Viewfinder: four corner marks with a label, like framing a shot. */
  .cursor__frame {
    position: absolute;
    width: 116px;
    height: 84px;
    margin: -42px 0 0 -58px;
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.25s ease,
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .cursor.is-frame .cursor__frame {
    opacity: 1;
    transform: scale(1);
  }
  .cursor__frame i {
    position: absolute;
    width: 18px;
    height: 18px;
    border: 0 solid var(--accent);
  }
  .cursor__frame i:nth-child(1) { top: 0; left: 0; border-top-width: 2.5px; border-left-width: 2.5px; }
  .cursor__frame i:nth-child(2) { top: 0; right: 0; border-top-width: 2.5px; border-right-width: 2.5px; }
  .cursor__frame i:nth-child(3) { bottom: 0; left: 0; border-bottom-width: 2.5px; border-left-width: 2.5px; }
  .cursor__frame i:nth-child(4) { bottom: 0; right: 0; border-bottom-width: 2.5px; border-right-width: 2.5px; }
  .cursor__label {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font: 600 13px/1 var(--font-body);
    white-space: nowrap;
  }

  /* ---------- Magnetic ---------- */
  [data-magnetic] {
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: transform;
  }

  /* ---------- Scroll reveals (only on elements the script marks) ---------- */
  .will-reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: var(--reveal-delay, 0s);
  }
  .will-reveal.is-in {
    opacity: 1;
    transform: none;
  }

  /* ---------- Shutter easter egg ---------- */
  .shutter {
    position: fixed;
    inset: 0;
    z-index: 99;
    pointer-events: none;
    background: #ffffff;
    opacity: 0;
  }
  .shutter.is-firing {
    animation: shutter-flash 0.6s ease-out;
  }
  @keyframes shutter-flash {
    0% { opacity: 0; }
    12% { opacity: 0.9; }
    100% { opacity: 0; }
  }
  .shutter-toast {
    position: fixed;
    left: 50%;
    bottom: 28px;
    z-index: 99;
    margin: 0;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-size: 14px;
    font-weight: 500;
    transform: translate(-50%, 20px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .shutter-toast.is-shown {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .will-reveal {
      opacity: 1;
      transform: none;
    }
    .shutter.is-firing {
      animation: none;
    }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const root = document.documentElement;

  /* ---------- Console easter egg ---------- */
  console.log(
    '%cHi, curious one. 👋%c\nYou found the console. I design for revenue and I care about the details, like this one.\nLet\'s talk: 6meganc@gmail.com',
    'font: 700 16px system-ui; color: #f26b1d',
    'font: 13px system-ui',
  );

  /* ---------- Cursor ---------- */
  if (finePointer && !reduce) {
    const cursor = document.querySelector<HTMLElement>('.cursor')!;
    const label = cursor.querySelector<HTMLElement>('.cursor__label')!;
    root.classList.add('has-cursor');
    let x = -100, y = -100, cx = x, cy = y;
    addEventListener('pointermove', (e) => {
      x = e.clientX;
      y = e.clientY;
      const t = e.target as Element;
      const card = t.closest('.card');
      const link = t.closest('a, button, [data-cursor]');
      const text = t.closest('input, textarea');
      cursor.classList.toggle('is-frame', !!card);
      cursor.classList.toggle('is-link', !card && !!link);
      cursor.classList.toggle('is-text', !!text);
      if (card) {
        label.textContent = card.classList.contains('card--soon')
          ? 'Coming soon'
          : card.querySelector('.card__lock')
            ? 'Locked'
            : 'View';
      }
    }, { passive: true });
    document.addEventListener('pointerleave', () => cursor.classList.add('is-hidden'));
    document.addEventListener('pointerenter', () => cursor.classList.remove('is-hidden'));
    const tick = () => {
      cx += (x - cx) * 0.22;
      cy += (y - cy) * 0.22;
      cursor.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
      requestAnimationFrame(tick);
    };
    tick();

    /* ---------- Magnetic buttons ---------- */
    const magnets = () =>
      document.querySelectorAll<HTMLElement>('.cta:not(.cta--pending), .theme-toggle, [data-magnetic]').forEach((el) => {
        if (el.dataset.magnetBound) return;
        el.dataset.magnetBound = '1';
        el.setAttribute('data-magnetic', '');
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          const dx = (e.clientX - (r.left + r.width / 2)) / r.width;
          const dy = (e.clientY - (r.top + r.height / 2)) / r.height;
          el.style.transform = `translate(${dx * 10}px, ${dy * 8}px)`;
        });
        el.addEventListener('pointerleave', () => (el.style.transform = ''));
      });
    magnets();
    new MutationObserver(magnets).observe(document.querySelector('main')!, { childList: true, subtree: true });
  }

  /* ---------- Count-ups ---------- */
  const countUp = (el: HTMLElement) => {
    const text = el.textContent ?? '';
    const m = text.match(/^(\D*)([\d,.]+)(.*)$/);
    if (!m || reduce) return;
    const [, pre, num, post] = m;
    const target = parseFloat(num.replace(/,/g, ''));
    const decimals = (num.split('.')[1] ?? '').length;
    const start = performance.now();
    const dur = 1400;
    const step = (now: number) => {
      const p = Math.min(1, (now - start) / dur);
      const eased = 1 - Math.pow(1 - p, 4);
      el.textContent = pre + (target * eased).toFixed(decimals) + post;
      if (p < 1) requestAnimationFrame(step);
      else el.textContent = text;
    };
    requestAnimationFrame(step);
  };

  /* ---------- Scroll reveals ---------- */
  const REVEAL = [
    '.section .eyebrow',
    '.section h2',
    '.card',
    '.more-work',
    '.principle',
    '.about__lead',
    '.metric',
    '.item',
    '.shot',
    '.col',
    '.component',
    '.quote',
    '.interests li',
    '.exp',
  ].join(',');

  if (!reduce) {
    // A scroll check (rather than IntersectionObserver alone) so fast jumps, like the End key or
    // clicking an anchor, still reveal everything the visitor has scrolled to or past.
    let pending: HTMLElement[] = [];
    const reveal = (el: HTMLElement) => {
      el.classList.add('is-in');
      el.querySelectorAll<HTMLElement>('.metric__value').forEach(countUp);
    };
    const check = () => {
      const line = innerHeight * 0.9;
      pending = pending.filter((el) => {
        if (el.getBoundingClientRect().top < line) {
          reveal(el);
          return false;
        }
        return true;
      });
    };
    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        check();
      });
    };
    const scan = () => {
      const vh = innerHeight;
      let i = 0;
      document.querySelectorAll<HTMLElement>(REVEAL).forEach((el) => {
        if (el.dataset.revealBound) return;
        el.dataset.revealBound = '1';
        // Already on screen: leave it visible, no hiding.
        if (el.getBoundingClientRect().top < vh * 0.92) return;
        el.style.setProperty('--reveal-delay', `${(i++ % 3) * 0.08}s`);
        el.classList.add('will-reveal');
        pending.push(el);
      });
    };
    scan();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    // Content injected later (e.g. an unlocked case study) gets the same treatment.
    new MutationObserver(() => {
      scan();
      check();
    }).observe(document.querySelector('main')!, { childList: true });
  }

  /* ---------- Hero $ count-up ---------- */
  document.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);

  /* ---------- Shutter easter egg: click the name 5 times ---------- */
  const brand = document.querySelector<HTMLAnchorElement>('.nav__brand');
  const shutter = document.querySelector<HTMLElement>('.shutter')!;
  const toast = document.querySelector<HTMLElement>('.shutter-toast')!;
  let clicks = 0, timer = 0;
  brand?.addEventListener('click', (e) => {
    const onHome = location.pathname === '/' || location.pathname.endsWith('/index.html');
    if (!onHome) return;
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    clicks++;
    clearTimeout(timer);
    timer = window.setTimeout(() => (clicks = 0), 1500);
    if (clicks >= 5) {
      clicks = 0;
      shutter.classList.remove('is-firing');
      void shutter.offsetWidth;
      shutter.classList.add('is-firing');
      toast.textContent = 'Click. Got your good side.';
      toast.classList.add('is-shown');
      setTimeout(() => toast.classList.remove('is-shown'), 2400);
    }
  });
</script>
